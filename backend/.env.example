# Copie para backend/.env e preencha. Nunca versione o .env.

# Postgres do Supabase (Project Settings > Database > Connection string > Session pooler).
# Sem esta variável, o backend usa SQLite local (./ifood_match.db) para desenvolvimento.
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Anthropic. Sem a chave, as explicações e a leitura de texto livre usam o fallback por regras.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_TIMEOUT_SECONDS=8

# Origens permitidas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,https://ifood-match.vercel.app

# Endereço público do frontend, usado para montar o link de convite.
FRONTEND_URL=http://localhost:5173

# Chave privada para abrir /metricas (gere uma longa e aleatória; não compartilhe).
ADMIN_TOKEN=
